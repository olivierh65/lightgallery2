{#
/**
 * @file
 * Default theme implementation for a lightGallery.
 *
 * Available variables:
 * - id: the element and settings ID.
 * - items: an array of items, each item is also an array with following elements:
 *   - attributes: the item wrapper attributes.
 *   - content: the item content.
 *   - item: the field item (optional).
 * - inline: indicates if the gallery should be inline.
 * - settings: an associative array of lightGallery settings.
 * - init: indicates if the gallery will be initalized automatically.
 * - attributes: array of HTML attributes populated by modules, intended to
 *   be added to the main container tag of this template.
 */
#}
{{ dump() }}
{%
  set classes = [
    'lightgallery',
  ]
%}
{%
  set item_classes = [
    'lightgallery__item',
  ]
%}

{% if items or settings.dynamic %}
  <div{{ attributes.addClass(classes) }}>
    {% if items %}
      <div class="lightgallery__items">
        {% for item in items %}
          <div{{ item.attributes.addClass(item_classes) }}>{{ item.content }}</div>
        {% endfor %}
      </div>
    {% endif %}

    {% if items and inline %}
      <div class="lightgallery__inline-container"></div>
    {% endif %}
  </div>
{% endif %}
